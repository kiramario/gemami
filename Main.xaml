<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <!-- 颜色定义 -->
        <SolidColorBrush x:Key="HeaderBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#252526"/>
        <SolidColorBrush x:Key="ContentBg" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="OutputBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AccentColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#333333"/>
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        
        <!-- TreeView 样式 -->
        <Style x:Key="ToolTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <!-- 主容器 -->
    <Border x:Name="RootBorder" Background="{StaticResource ContentBg}" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>
        <DockPanel>
            
            <!-- ========== 顶部标题栏 ========== -->
            <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Height="50" Background="{StaticResource HeaderBg}"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="🧰" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Gemini" FontSize="16" FontWeight="Bold" 
                                   Foreground="{StaticResource TextWhite}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <!-- 主题切换 -->
                        <ComboBox x:Name="CmbTheme" Width="80" Height="26"
                                  Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555"
                                  VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12">
                            <ComboBoxItem Content="浅色" Tag="Light"/>
                            <ComboBoxItem Content="暗色" Tag="Dark"/>
                            <ComboBoxItem Content="深蓝" Tag="DeepBlue"/>
                            <ComboBoxItem Content="暖橙" Tag="Warm"/>
                        </ComboBox>
                        <!-- 搜索框 -->
                        <Border x:Name="SearchBorder" Background="#3E3E42" CornerRadius="4" Width="200" Height="30" Margin="0,0,10,0">
                            <Grid>
                                <TextBox x:Name="SearchBox" Foreground="#CCCCCC" 
                                         Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Padding="8,0"
                                         FontSize="13">
                                </TextBox>
                                <TextBlock x:Name="SearchPlaceholder" Text="🔍 搜索工具..."
                                           Foreground="#888888" VerticalAlignment="Center"
                                           Margin="8,0,0,0" FontSize="13"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <!-- 设置按钮 -->
                        <Button x:Name="BtnSettings" Content="⚙" Width="30" Height="30"
                                Background="Transparent" Foreground="{StaticResource TextWhite}"
                                BorderThickness="0" FontSize="16" Cursor="Hand"
                                ToolTip="设置"/>
                        <!-- 缩放按钮 -->
                        <Button x:Name="BtnZoomIn" Content="🔍" Width="30" Height="30"
                                Background="Transparent" Foreground="{StaticResource TextWhite}"
                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                ToolTip="放大窗口"/>
                        <Button x:Name="BtnZoomOut" Content="🔎" Width="30" Height="30"
                                Background="Transparent" Foreground="{StaticResource TextWhite}"
                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                ToolTip="缩小窗口"/>
                        <!-- 全屏按钮 -->
                        <Button x:Name="BtnFullscreen" Content="⛶" Width="30" Height="30"
                                Background="Transparent" Foreground="{StaticResource TextWhite}"
                                BorderThickness="0" FontSize="16" Cursor="Hand"
                                ToolTip="全屏 (ESC 退出)"/>
                        <!-- 关闭按钮 -->
                        <Button x:Name="BtnClose" Content="✕" Width="30" Height="30"
                                Background="Transparent" Foreground="{StaticResource TextWhite}"
                                BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ========== 左侧导航 ========== -->
            <Border x:Name="SidebarBorder" DockPanel.Dock="Left" Width="220" Background="{StaticResource SidebarBg}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TreeView x:Name="ToolTree" Background="Transparent" 
                              BorderThickness="0" Margin="5,0">
                    </TreeView>
                    
                    <!-- 底部输出切换按钮 -->
                    <ToggleButton x:Name="BtnToggleOutput" Grid.Row="1" 
                                  Content="📋 输出日志" Height="35"
                                  Background="Transparent" Foreground="#AAAAAA"
                                  BorderThickness="0" Cursor="Hand"
                                  IsChecked="True"/>
                </Grid>
            </Border>
            
            <!-- ========== 中间内容区 ========== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition x:Name="OutputRow" Height="180"/>
                </Grid.RowDefinitions>
                
                <!-- 工具内容展示区 -->
                <ContentControl x:Name="ToolContent" Margin="20">
                    <!-- 默认欢迎页 -->
                    <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🛠️" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="WelcomeTitle" Text="欢迎使用 Gemini" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WelcomeSubtitle" Text="请从左侧选择一个工具开始使用"
                                   FontSize="14" Foreground="#888888" HorizontalAlignment="Center" Margin="0,5,0,30"/>
                        
                        <!-- 快速入口卡片 -->
                        <WrapPanel HorizontalAlignment="Center" ItemWidth="200" ItemHeight="100">
                            <!-- 文件重命名 -->
                            <Border Background="{StaticResource CardBg}" CornerRadius="6" 
                                    Margin="5" Cursor="Hand"
                                    Tag="文件重命名" Width="190" Height="90">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="文件重命名" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock Text="批量重命名文件" FontSize="11" Foreground="#888888"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- 系统信息 -->
                            <Border Background="{StaticResource CardBg}" CornerRadius="6"
                                    Margin="5" Cursor="Hand"
                                    Tag="系统信息" Width="190" Height="90">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="💻" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="系统信息" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock Text="查看系统详细配置" FontSize="11" Foreground="#888888"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- 网络检测 -->
                            <Border Background="{StaticResource CardBg}" CornerRadius="6"
                                    Margin="5" Cursor="Hand"
                                    Tag="网络检测" Width="190" Height="90">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="网络检测" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock Text="Ping + 端口扫描" FontSize="11" Foreground="#888888"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ContentControl>
                
                <!-- 拖拽分割条 -->
                <GridSplitter x:Name="Splitter" Grid.Row="1" Height="5" 
                              HorizontalAlignment="Stretch" Background="{StaticResource BorderColor}"
                              Cursor="SizeNS"/>
                
                <!-- ========== 底部输出日志 ========== -->
                <Border x:Name="OutputBorder" Grid.Row="2" Background="{StaticResource OutputBg}" CornerRadius="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 日志标题栏 -->
                        <Border x:Name="LogTitleBorder" Background="#2A2A2E">
                            <Grid>
                                <TextBlock Text="📋 输出日志" Foreground="#AAAAAA" 
                                           FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                                    <Button x:Name="BtnClearLog" Content="清空" Width="50" Height="22"
                                            Background="#3E3E42" Foreground="#CCCCCC" BorderThickness="0"
                                            FontSize="11" Cursor="Hand" Margin="0,0,5,0"/>
                                    <Button x:Name="BtnCopyLog" Content="复制" Width="50" Height="22"
                                            Background="#3E3E42" Foreground="#CCCCCC" BorderThickness="0"
                                            FontSize="11" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- 日志内容 -->
                        <RichTextBox x:Name="OutputLog" Grid.Row="1" 
                                     Background="{StaticResource OutputBg}" 
                                     Foreground="#D4D4D4"
                                     FontFamily="Consolas" FontSize="12"
                                     BorderThickness="0" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="8,0"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
